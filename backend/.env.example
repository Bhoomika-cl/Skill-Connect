# Keep real credentials in backend/.env, which is ignored by Git.
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=skillconnect

# Optional CirrusLabs Microsoft Entra configuration. Obtain real values from IT.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://127.0.0.1:8000/api/auth/microsoft/callback
MS_API_AUDIENCE=
MS_API_SCOPE=
MS_ALLOWED_GROUP_ID=
MS_ADMIN_GROUP_ID=
SSO_FRONTEND_URL=http://127.0.0.1:5173
SSO_REQUIRED=false
COOKIE_SECURE=false
